# Console environment (Vercel: Project Settings -> Environment Variables; local: frontend/.env.local).
# NEXT_PUBLIC_* values are inlined at build time: redeploy after changing them.

# Base Server URL. Empty = auto (same host, port 8000 / same origin behind the HTTPS proxy).
# Vercel + Render: https://<service>.onrender.com
NEXT_PUBLIC_API_BASE=

# Keep-alive ping of <API>/health while a page is open (only for remote APIs, never for LAN).
# Interval in ms, default 240000 (4 min; Render free sleeps after 15 min). 0 disables it.
NEXT_PUBLIC_KEEPALIVE_MS=
